{
  "template": "obsidian-mind",
  "version": "8.3.2",
  "released": "2026-08-03",
  "qmd_index": "",
  "qmd_min_version": "2.0.0",
  "open_loop_dirs": [
    "trabalho/individuais",
    "trabalho/reunioes",
    "trabalho/incidentes"
  ],
  "open_loop_sections": [
    "action items",
    "what to watch"
  ],
  "eager_layer_budget_bytes": 80000,
  "listing_collapse_threshold": 12,
  "memory_root": "memorias",
  "mcp_exposed_roots": [],
  "mcp_never_expose": [],
  "mcp_inbox": "inbox",
  "qmd_context": "Personal knowledge vault built on obsidian-mind, for a professional coordinating projects, meetings, people/team context, and career-review evidence in one place. People and teams in equipe/, active work and daily logs in trabalho/, career-review evidence in desempenho/, decisions and patterns in cerebro/. Multi-agent (Claude Code, Codex, Gemini) with lifecycle hooks and QMD semantic search. Ground for 'what did we decide', 'who is this person', and daily/weekly planning. Folder names are in Portuguese (cerebro=brain, equipe=org, desempenho=perf, trabalho=work, referencia=reference, modelos=templates, rascunhos=thinking, memorias=memories) -- translated from the upstream obsidian-mind template.",
  "infrastructure": [
    "CLAUDE.md",
    "AGENTS.md",
    "GEMINI.md",
    "Home.md",
    "README.md",
    "README.*.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "ARCHITECTURE.md",
    "LICENSE",
    ".gitignore",
    ".mcp.json",
    ".claude/**",
    ".claude-plugin/**",
    ".codex/**",
    ".gemini/**",
    "modelos/**",
    "bases/**",
    ".scripts/**",
    "vault-manifest.json",
    "obsidian-mind-logo.png",
    "obsidian-mind-demo.gif",
    "cerebro/Habilidades.md",
    "desempenho/competencias/README.md",
    "rascunhos/README.md",
    "trabalho/reunioes/README.md",
    ".shardmind/**",
    ".shardmindignore"
  ],
  "scaffold": {
    "cerebro/Norte.md": "Personal goals — replace if source has real content",
    "cerebro/Memórias.md": "Memory index — replace if source has entries beyond template stubs",
    "cerebro/Decisões-Chave.md": "Decision log — replace if non-empty",
    "cerebro/Padrões.md": "Observed patterns — replace if non-empty",
    "cerebro/Armadilhas.md": "Known gotchas — replace if non-empty",
    "trabalho/Índice.md": "Work notes MOC — replace if has real entries",
    "equipe/Pessoas e Contexto.md": "People MOC — replace if has real entries",
    "desempenho/Conquistas.md": "Brag doc index — replace if has entries"
  },
  "user_content_roots": [
    "trabalho/ativos/",
    "trabalho/arquivo/",
    "trabalho/incidentes/",
    "trabalho/individuais/",
    "trabalho/diario/",
    "equipe/pessoas/",
    "equipe/times/",
    "desempenho/conquistas/",
    "desempenho/evidencias/",
    "desempenho/h*-*/",
    "desempenho/competencias/*.md",
    "cerebro/*.md",
    "referencia/",
    "memorias/"
  ],
